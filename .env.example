# Copy to .env and fill in what you use. Never commit .env.

# Default model (LiteLLM name). Free options:
#   groq/openai/gpt-oss-120b         (needs GROQ_API_KEY, free tier at console.groq.com)
#   gemini/gemini-2.5-flash          (needs GEMINI_API_KEY, free tier at aistudio.google.com)
#   ollama/qwen2.5:7b                (local, no key; run `ollama pull qwen2.5:7b`)
MODEL=groq/openai/gpt-oss-120b

GEMINI_API_KEY=
GROQ_API_KEY=
# Optional paid providers (users can also paste their own key in the popup Settings tab)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Where Ollama runs
OLLAMA_API_BASE=http://localhost:11434

# Mail source: "file" (data/sample_mails.json or an .mbox) or "gmail"
MAIL_SOURCE=file
MAIL_FILE=data/sample_mails.json
GMAIL_CREDENTIALS=secrets/credentials.json
GMAIL_TOKEN=secrets/token.json

# Your name, used to sign drafts
USER_NAME=Sam Rivera

# Optional cross-encoder rerank after hybrid retrieval (downloads ~90 MB on first use)
RERANK=false
# Refuse any non-ollama model
LOCAL_ONLY=false
